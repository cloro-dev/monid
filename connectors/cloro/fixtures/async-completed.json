{
    "name": "cloro async task completed (synthetic)",
    "description": "Synthetic /v1/async/task chain, shaped after the published OpenAPI responses and cloro's fetch-async-task controller. The submit returns a QUEUED task T1. The first status lookup answers 503 (transient: the poll must stay RUNNING), the second PROCESSING, the third COMPLETED with credits.creditsCharged 9 and a response that carries three productResults. Each test sets the claim it needs. {{request.url}} binds the submit and the status urls. No live recording is claimed.",
    "calls": [
        {
            "req": { "method": "POST", "url": "{{request.url}}" },
            "res": {
                "status": 200,
                "body": {
                    "success": true,
                    "task": {
                        "id": "T1",
                        "taskType": "CHATGPT",
                        "status": "QUEUED",
                        "priority": 1,
                        "createdAt": "2026-09-23T15:00:00.000Z",
                        "latencyMs": null,
                        "idempotencyKey": "run-1"
                    },
                    "credits": { "creditsToCharge": 9, "creditsCharged": 0 }
                }
            }
        },
        {
            "req": { "method": "GET", "url": "{{request.url}}/T1" },
            "res": {
                "status": 503,
                "body": {
                    "success": false,
                    "error": {
                        "code": "SERVICE_UNAVAILABLE",
                        "message": "Service unavailable"
                    }
                }
            }
        },
        {
            "req": { "method": "GET", "url": "{{request.url}}/T1" },
            "res": {
                "status": 200,
                "body": {
                    "task": {
                        "id": "T1",
                        "taskType": "CHATGPT",
                        "status": "PROCESSING",
                        "priority": 1,
                        "createdAt": "2026-09-23T15:00:00.000Z",
                        "latencyMs": null,
                        "idempotencyKey": "run-1"
                    },
                    "credits": { "creditsToCharge": 9, "creditsCharged": 0 }
                }
            }
        },
        {
            "req": { "method": "GET", "url": "{{request.url}}/T1" },
            "res": {
                "status": 200,
                "body": {
                    "task": {
                        "id": "T1",
                        "taskType": "CHATGPT",
                        "status": "COMPLETED",
                        "priority": 1,
                        "createdAt": "2026-09-23T15:00:00.000Z",
                        "latencyMs": 3420,
