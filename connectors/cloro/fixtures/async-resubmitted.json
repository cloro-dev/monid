{
    "name": "cloro async submit retried (synthetic)",
    "description": "Synthetic /v1/async/task chain for a retried submit: an earlier attempt of the run created the task with idempotencyKey run-1, so the submit answers 409 with details.field idempotencyKey (cloro's ApiErrors.alreadyExists body). start must park RUNNING with externalRunId run-1, which the status endpoint resolves as an idempotencyKey. Then the status lookup by the key answers COMPLETED. No live recording is claimed.",
    "calls": [
        {
            "req": { "method": "POST", "url": "{{request.url}}" },
            "res": {
                "status": 409,
                "body": {
                    "success": false,
                    "error": {
                        "code": "RESOURCE_ALREADY_EXISTS",
                        "message": "Task already exists",
                        "details": {
                            "field": "idempotencyKey",
                            "value": "run-1"
                        },
                        "timestamp": "2026-09-23T15:00:00.000Z"
                    }
                }
            }
        },
        {
            "req": { "method": "GET", "url": "{{request.url}}/run-1" },
            "res": {
                "status": 200,
                "body": {
                    "task": {
                        "id": "T1",
                        "taskType": "CHATGPT",
                        "status": "COMPLETED",
                        "priority": 1,
                        "createdAt": "2026-09-23T15:00:00.000Z",
                        "latencyMs": 3420,
                        "idempotencyKey": "run-1"
                    },
                    "credits": { "creditsToCharge": 5, "creditsCharged": 5 },
                    "response": {
                        "text": "Example Corp makes project management software."
                    }
                }
            }
        }
    ]
}
